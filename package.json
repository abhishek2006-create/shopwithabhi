{
  "name": "shopwithabhi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "convex:dev": "convex dev",
    "setup:backend": "node scripts/setup-backend.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "keys": "node scripts/generate-keys.mjs",
    "deploy:build": "convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd \"npm run build\"",
    "format": "prettier --write .",
    "prebuild": "node scripts/validate-env.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "convex": "1.47.0",
    "gsap": "3.15.0",
    "jose": "6.2.13",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sanitize-html": "2.18.1",
    "sonner": "2.0.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "convex-test": "0.0.62",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
