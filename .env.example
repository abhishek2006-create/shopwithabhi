# Local preview works without credentials; database features require Convex.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Vercel only: production deployment key, never public
CONVEX_DEPLOY_KEY=
# NextAuth v4 uses NEXTAUTH_ names
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Run npm run keys, then copy private JWK into this single-line variable.
AUTH_PRIVATE_JWK=
# Same issuer in Next.js and Convex environment
AUTH_ISSUER=http://localhost:3000
# Set on Convex: public JWKS data URI generated by npm run keys
AUTH_JWKS=
# Set on Convex only: comma-separated verified Google email addresses
ADMIN_EMAILS=
# Shared Next.js + Convex secret for public form gateway, at least 32 characters
FORM_GATEWAY_SECRET=
# Approved affiliate configuration, no links generated automatically
AMAZON_MARKETPLACE=IN
AMAZON_ASSOCIATE_TAG=YOUR_AMAZON_ASSOCIATE_TAG
# Enable only after reviewing disclosure/privacy policy
AFFILIATE_CLICK_TRACKING=false
# Optional retention defaults configured in convex/maintenance.ts
